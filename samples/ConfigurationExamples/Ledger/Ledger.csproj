    <IsPackable>false</IsPackable>
    <RootNamespace>RonSijm.RepoGen.ConfigurationExamples.Ledger</RootNamespace>
    <RepoGenCheckCommand>dotnet &quot;$(MSBuildThisFileDirectory)../GenerationRunner/bin/$(Configuration)/net10.0/GenerationRunner.dll&quot; &quot;$(MSBuildThisFileDirectory)..&quot; --check</RepoGenCheckCommand>

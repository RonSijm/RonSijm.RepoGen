    <ProjectReference Include="../Models/Models.csproj" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <ProjectReference Include="../../../src/RonSijm.RepoGen.Design/RonSijm.RepoGen.Design.csproj" />
    <ProjectReference Include="../../../src/RonSijm.RepoGen.Testing/RonSijm.RepoGen.Testing.csproj" />
    <ProjectReference Include="../../../src/RonSijm.RepoGen.Sqlite/RonSijm.RepoGen.Sqlite.csproj" />
  </ItemGroup>
</Project>

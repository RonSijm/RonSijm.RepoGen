    <IsPackable>false</IsPackable>
    <RootNamespace>RonSijm.RepoGen.ConfigurationExamples.Designers</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Inputs live with the example that owns them, not in this build-support folder. -->
